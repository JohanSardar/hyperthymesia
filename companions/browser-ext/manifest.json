{
  "manifest_version": 3,
  "name": "Hyperthymesia Companion",
  "version": "0.1.0",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "nativeMessaging",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}