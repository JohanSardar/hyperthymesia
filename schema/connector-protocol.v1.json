{
  "$defs": {
    "BlobRef": {
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "media_type": {
          "type": "string"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the blob bytes.",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "media_type",
        "bytes"
      ],
      "type": "object"
    },
    "BootId": {
      "description": "One boot session of a device. Monotonic clocks are only comparable within a boot.",
      "type": "string"
    },
    "Capabilities": {
      "properties": {
        "connector": {
          "type": "string"
        },
        "connector_instance": {
          "$ref": "#/$defs/ConnectorInstance"
        },
        "kinds": {
          "description": "Kinds this connector may emit.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mutable_source": {
          "description": "The source mutates or deletes objects (so `upsert`/`delete` may appear).",
          "type": "boolean"
        },
        "supports_backfill": {
          "type": "boolean"
        },
        "supports_changes": {
          "type": "boolean"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "connector_instance",
        "connector",
        "version",
        "kinds",
        "supports_backfill",
        "supports_changes",
        "mutable_source"
      ],
      "type": "object"
    },
    "ChangeBatch": {
      "properties": {
        "complete": {
          "description": "False when the source could not be fully read (locked, truncated, rate-limited).",
          "type": "boolean"
        },
        "connector_instance": {
          "$ref": "#/$defs/ConnectorInstance"
        },
        "envelopes": {
          "items": {
            "$ref": "#/$defs/Envelope"
          },
          "type": "array"
        },
        "next": {
          "$ref": "#/$defs/Cursor",
          "description": "Cursor to persist once this batch is stored."
        }
      },
      "required": [
        "connector_instance",
        "envelopes",
        "next",
        "complete"
      ],
      "type": "object"
    },
    "ClockDomain": {
      "oneOf": [
        {
          "const": "mach_continuous",
          "description": "`mach_continuous_time`: advances during sleep.",
          "type": "string"
        },
        {
          "const": "mach_absolute",
          "description": "`mach_absolute_time`: stops during sleep.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A source-specific monotonic counter.",
          "type": "string"
        }
      ]
    },
    "CollectorStatus": {
      "oneOf": [
        {
          "enum": [
            "running",
            "failed",
            "stopped"
          ],
          "type": "string"
        },
        {
          "const": "paused",
          "description": "Paused on purpose (user pause, policy). Metadata keeps flowing.",
          "type": "string"
        },
        {
          "const": "permission_denied",
          "description": "Missing OS permission.",
          "type": "string"
        }
      ]
    },
    "Completeness": {
      "enum": [
        "complete",
        "partial",
        "truncated",
        "unknown"
      ],
      "type": "string"
    },
    "ConnectorInstance": {
      "description": "e.g. `macos-agent:mbp-main`, `t3code:mbp-main:statev2`.",
      "type": "string"
    },
    "Coverage": {
      "properties": {
        "completeness": {
          "$ref": "#/$defs/Completeness"
        },
        "scope": {
          "description": "What this observation claims to cover, e.g. `focused_window` or `backfill:2026-10-30`.",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "completeness"
      ],
      "type": "object"
    },
    "CoverageReport": {
      "properties": {
        "completeness": {
          "$ref": "#/$defs/Completeness"
        },
        "connector_instance": {
          "$ref": "#/$defs/ConnectorInstance"
        },
        "from": {
          "format": "date-time",
          "type": "string"
        },
        "reason": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "connector_instance",
        "from",
        "to",
        "completeness"
      ],
      "type": "object"
    },
    "Cursor": {
      "description": "Opaque resume position plus a generation that changes when the source is\nrebuilt (file rotated, database recreated). A generation change invalidates the cursor.",
      "properties": {
        "generation": {
          "type": "string"
        },
        "position": {
          "type": "string"
        }
      },
      "required": [
        "generation",
        "position"
      ],
      "type": "object"
    },
    "Envelope": {
      "properties": {
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "blobs": {
          "items": {
            "$ref": "#/$defs/BlobRef"
          },
          "type": "array"
        },
        "connector_instance": {
          "$ref": "#/$defs/ConnectorInstance",
          "description": "Installation/account/stream that produced it. Authenticated by the server."
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "device": {
          "type": [
            "string",
            "null"
          ]
        },
        "envelope_version": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "description": "Namespaced kind, e.g. `focus.span`. See [`kinds`].",
          "type": "string"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "type": "array"
        },
        "observation_id": {
          "$ref": "#/$defs/ObservationId",
          "description": "Immutable identity of this observation, persisted by the producer before upload."
        },
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "payload": true,
        "resource": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "description": "Source revision or content digest. Append-only sources use `\"0\"`.",
          "type": "string"
        },
        "schema_version": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity",
          "default": "restricted"
        },
        "sequence": {
          "description": "Producer sequence number, monotonically increasing per connector instance.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source_key": {
          "description": "Native identity of the source object or event.",
          "type": "string"
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "time": {
          "$ref": "#/$defs/ObservationTime"
        }
      },
      "required": [
        "envelope_version",
        "observation_id",
        "connector_instance",
        "source_key",
        "revision",
        "operation",
        "kind",
        "schema_version",
        "time",
        "payload"
      ],
      "type": "object"
    },
    "Health": {
      "properties": {
        "connector_instance": {
          "$ref": "#/$defs/ConnectorInstance"
        },
        "detail": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CollectorStatus"
        }
      },
      "required": [
        "connector_instance",
        "status",
        "observed_at"
      ],
      "type": "object"
    },
    "Link": {
      "properties": {
        "rel": {
          "description": "Relationship name, e.g. `session`, `parent`, `caused_by`, `same_as`.",
          "type": "string"
        },
        "target": {
          "description": "Target identity, usually a `source_key` of another observation.",
          "type": "string"
        }
      },
      "required": [
        "rel",
        "target"
      ],
      "type": "object"
    },
    "MonoStamp": {
      "properties": {
        "boot_id": {
          "$ref": "#/$defs/BootId"
        },
        "domain": {
          "$ref": "#/$defs/ClockDomain"
        },
        "nanos": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "domain",
        "boot_id",
        "nanos"
      ],
      "type": "object"
    },
    "ObservationId": {
      "type": "string"
    },
    "ObservationTime": {
      "properties": {
        "calibration": {
          "description": "Id of the latest clock-calibration observation for this device, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "mono_end": {
          "anyOf": [
            {
              "$ref": "#/$defs/MonoStamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "mono_start": {
          "anyOf": [
            {
              "$ref": "#/$defs/MonoStamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "description": "When the producer collected it.",
          "format": "date-time",
          "type": "string"
        },
        "resolution_ms": {
          "description": "Resolution of the source timestamps, in milliseconds (1000 for whole seconds).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_end": {
          "description": "End of a span; `None` for point events or open spans.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "source_start": {
          "description": "When the event happened according to the source. `None` if the source has no time.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "utc_offset_min": {
          "description": "UTC offset of the device at capture, in minutes. Needed for civil days.",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "resolution_ms",
        "observed_at"
      ],
      "type": "object"
    },
    "Operation": {
      "oneOf": [
        {
          "const": "observe",
          "description": "A new immutable observation.",
          "type": "string"
        },
        {
          "const": "upsert",
          "description": "A new revision of a mutable source object.",
          "type": "string"
        },
        {
          "const": "delete",
          "description": "The source object was deleted at the source.",
          "type": "string"
        }
      ]
    },
    "Sensitivity": {
      "description": "Disclosure class. Unknown data is `Restricted`; a producer label can only\nnarrow disclosure, never grant it (the server applies its own rules).",
      "enum": [
        "normal",
        "sensitive",
        "restricted"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/Capabilities",
      "properties": {
        "type": {
          "const": "describe",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "$ref": "#/$defs/ChangeBatch",
      "properties": {
        "type": {
          "const": "changes",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "$ref": "#/$defs/CoverageReport",
      "properties": {
        "type": {
          "const": "coverage",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "$ref": "#/$defs/Health",
      "properties": {
        "type": {
          "const": "health",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "description": "Server → connector: stored durably up to this cursor.",
      "properties": {
        "connector_instance": {
          "$ref": "#/$defs/ConnectorInstance"
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        },
        "type": {
          "const": "checkpoint",
          "type": "string"
        }
      },
      "required": [
        "type",
        "connector_instance",
        "cursor"
      ],
      "type": "object"
    }
  ],
  "title": "ConnectorMessage"
}
