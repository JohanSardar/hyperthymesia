{
  "$defs": {
    "AgentMessage": {
      "properties": {
        "cwd": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "description": "`t3code`, `codex`, `claude-code`, ...",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "text": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "thread_title": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "turn_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider",
        "thread_id",
        "role",
        "text"
      ],
      "type": "object"
    },
    "AgentRole": {
      "oneOf": [
        {
          "const": "user",
          "description": "A human request.",
          "type": "string"
        },
        {
          "const": "assistant",
          "description": "Assistant output.",
          "type": "string"
        },
        {
          "const": "tool",
          "description": "Tool call or tool result.",
          "type": "string"
        },
        {
          "const": "lifecycle",
          "description": "Lifecycle record (thread created, turn started/finished).",
          "type": "string"
        }
      ]
    },
    "CalendarEvent": {
      "properties": {
        "attendees": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "location": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "planned": {
          "$ref": "#/$defs/Interval"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "planned"
      ],
      "type": "object"
    },
    "ClockCalibration": {
      "properties": {
        "error_ms": {
          "description": "Error bound of the estimate, ms.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "method": {
          "type": "string"
        },
        "offset_ms": {
          "description": "Estimated offset of the device wall clock from true UTC, ms.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "offset_ms",
        "error_ms",
        "method"
      ],
      "type": "object"
    },
    "CodeCommit": {
      "properties": {
        "author": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "files_changed": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "sha": {
          "type": "string"
        }
      },
      "required": [
        "repo",
        "sha",
        "message"
      ],
      "type": "object"
    },
    "CollectorHealth": {
      "properties": {
        "collector": {
          "type": "string"
        },
        "detail": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "dropped": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "last_observed_at": {
          "default": null,
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "last_sequence": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "queue_age_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/CollectorStatus"
        }
      },
      "required": [
        "collector",
        "status",
        "dropped"
      ],
      "type": "object"
    },
    "CollectorStatus": {
      "oneOf": [
        {
          "enum": [
            "running",
            "failed",
            "stopped"
          ],
          "type": "string"
        },
        {
          "const": "paused",
          "description": "Paused on purpose (user pause, policy). Metadata keeps flowing.",
          "type": "string"
        },
        {
          "const": "permission_denied",
          "description": "Missing OS permission.",
          "type": "string"
        }
      ]
    },
    "Completeness": {
      "enum": [
        "complete",
        "partial",
        "truncated",
        "unknown"
      ],
      "type": "string"
    },
    "DeviceState": {
      "oneOf": [
        {
          "enum": [
            "locked",
            "device_asleep",
            "display_off"
          ],
          "type": "string"
        },
        {
          "const": "active",
          "description": "Unlocked, awake, input seen recently.",
          "type": "string"
        },
        {
          "const": "idle",
          "description": "Unlocked and awake, no input for the idle threshold.",
          "type": "string"
        }
      ]
    },
    "FocusSpan": {
      "description": "Foreground app/window exposure. Time is in the envelope.",
      "properties": {
        "app_bundle_id": {
          "type": "string"
        },
        "app_name": {
          "type": "string"
        },
        "display": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "pid": {
          "default": null,
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "window_title": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "app_bundle_id",
        "app_name"
      ],
      "type": "object"
    },
    "HealthSample": {
      "properties": {
        "algorithm_version": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "metric": {
          "type": "string"
        },
        "sampling_interval_s": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "shape": {
          "$ref": "#/$defs/SampleShape"
        },
        "source_day": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "unit",
        "value",
        "shape"
      ],
      "type": "object"
    },
    "InputBucket": {
      "description": "Input intensity for one bucket (normally 1 s). Never contains key identities.",
      "properties": {
        "bucket_ms": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "clicks": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "keys": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mouse_px": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scroll_events": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "bucket_ms",
        "keys",
        "clicks",
        "scroll_events",
        "mouse_px"
      ],
      "type": "object"
    },
    "Interval": {
      "description": "A half-open UTC interval `[start, end)`.",
      "properties": {
        "end": {
          "format": "date-time",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "LocationVisit": {
      "properties": {
        "accuracy_m": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "latitude": {
          "format": "double",
          "type": "number"
        },
        "longitude": {
          "format": "double",
          "type": "number"
        },
        "place_name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "type": "object"
    },
    "MediaChunk": {
      "properties": {
        "codec": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "frames": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "display",
        "codec",
        "width",
        "height",
        "frames"
      ],
      "type": "object"
    },
    "MediaStill": {
      "properties": {
        "app_bundle_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "display": {
          "type": "string"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "trigger": {
          "$ref": "#/$defs/StillTrigger"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "window_title": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "display",
        "trigger",
        "width",
        "height"
      ],
      "type": "object"
    },
    "MessageDirection": {
      "oneOf": [
        {
          "enum": [
            "sent"
          ],
          "type": "string"
        },
        {
          "const": "received",
          "description": "Delivered, not proof of being read.",
          "type": "string"
        }
      ]
    },
    "MessageEvent": {
      "properties": {
        "conversation": {
          "type": "string"
        },
        "counterpart": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "$ref": "#/$defs/MessageDirection"
        },
        "service": {
          "type": "string"
        },
        "text": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "service",
        "conversation",
        "direction"
      ],
      "type": "object"
    },
    "PresenceSpan": {
      "properties": {
        "idle_threshold_s": {
          "default": null,
          "description": "Idle threshold used to derive `Idle`, so the rule is reproducible.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/DeviceState"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "SampleShape": {
      "enum": [
        "point",
        "interval",
        "aggregate"
      ],
      "type": "string"
    },
    "ShellCommand": {
      "properties": {
        "command": {
          "description": "argv after redaction.",
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "duration_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "exit_code": {
          "default": null,
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "shell": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command",
        "cwd"
      ],
      "type": "object"
    },
    "StillTrigger": {
      "enum": [
        "focus_change",
        "content_change",
        "periodic",
        "server_request"
      ],
      "type": "string"
    },
    "TextSnapshot": {
      "properties": {
        "completeness": {
          "$ref": "#/$defs/Completeness"
        },
        "source": {
          "$ref": "#/$defs/TextSource"
        },
        "surface": {
          "description": "What surface the text came from, e.g. app bundle + window title, or a URL.",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "text_sha256": {
          "description": "SHA-256 of `text`, for dedup across a span.",
          "type": "string"
        },
        "visible": {
          "default": null,
          "description": "Loaded is not seen: true only when the text was in the visible viewport.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "surface",
        "source",
        "text",
        "text_sha256",
        "completeness"
      ],
      "type": "object"
    },
    "TextSource": {
      "enum": [
        "accessibility",
        "ocr",
        "page",
        "editor",
        "terminal"
      ],
      "type": "string"
    },
    "UiClick": {
      "description": "Accessibility context sampled after a click, at its own sample time.",
      "properties": {
        "app_bundle_id": {
          "type": "string"
        },
        "label": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "sample_lag_ms": {
          "description": "Milliseconds between the click and the hit-test sample.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "app_bundle_id",
        "sample_lag_ms"
      ],
      "type": "object"
    },
    "UsageAggregate": {
      "description": "Aggregate usage that cannot be placed into specific seconds.",
      "properties": {
        "app": {
          "type": "string"
        },
        "day": {
          "description": "Civil day of the source, `YYYY-MM-DD`.",
          "type": "string"
        },
        "device_label": {
          "type": "string"
        },
        "note": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "seconds_estimated": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "device_label",
        "app",
        "day",
        "seconds_estimated"
      ],
      "type": "object"
    },
    "WebVisit": {
      "properties": {
        "browser": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tab_id": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "title": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        },
        "visible": {
          "default": null,
          "description": "Page visible and browser window focused at observation time.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "window_id": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Every core payload, tagged by kind. Used for the JSON Schema export and for\ntyped decoding in normalizers and the compiler.",
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "focus.span",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/FocusSpan"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "presence.span",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/PresenceSpan"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "input.bucket",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/InputBucket"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "ui.click",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/UiClick"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "text.snapshot",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/TextSnapshot"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "web.visit",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/WebVisit"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "shell.command",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ShellCommand"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "code.commit",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/CodeCommit"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "agent.message",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/AgentMessage"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "calendar.event",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/CalendarEvent"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "message.event",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/MessageEvent"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "media.chunk",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/MediaChunk"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "media.still",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/MediaStill"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "usage.aggregate",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/UsageAggregate"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "health.sample",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/HealthSample"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "location.visit",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/LocationVisit"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "collector.health",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/CollectorHealth"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "clock.calibration",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ClockCalibration"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    }
  ],
  "title": "CorePayload"
}
